<!DOCTYPE etl SYSTEM "http://scriptella.org/dtd/etl.dtd">
<etl>
    <connection id="source" driver="text" url="${source.file}"/>
    <connection id="target" driver="text" url="${target.file}"/>
    <query connection-id="source">
        ^([^,]+),([^,]+)$
        <script connection-id="target">$2,$1</script>
    </query>
</etl>
