<!DOCTYPE etl SYSTEM "http://scriptella.org/dtd/etl.dtd">
<etl>
    <properties>
        <include href="${properties.file}"/>
    </properties>
    <connection id="source" driver="${source.driver}" url="${source.url}"
                user="${source.user}" password="${source.password}"
                classpath="${source.classpath}"/>
    <connection id="target" driver="${target.driver}" url="${target.url}"
                user="${target.user}" password="${target.password}"
                classpath="${target.classpath}"/>
    <query connection-id="source">
        SELECT id, name FROM people
        <script connection-id="target">
            INSERT INTO people (id, name) VALUES (?id, ?name)
        </script>
    </query>
</etl>
