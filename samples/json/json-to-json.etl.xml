<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE etl SYSTEM "http://scriptella.org/dtd/etl.dtd">
<etl>
    <description>select, rename and copy structured JSON values.</description>
    <connection id="source" driver="json" url="customers.json">
        format=json
    </connection>
    <connection id="target" driver="json" url="output/transformed-customers.json">
        format=json
    </connection>

    <query connection-id="source">
        response.customers
        <script connection-id="target">
            {
                "customerId": ?{row.id},
                "profile": {
                    "displayName": ?{row.customer.name},
                    "active": ?{row.customer.active}
                },
                "purchases": ?{row.items},
                "externalCode": ?{row['external.code']},
                "note": ?{row.note},
                "source": "customer-import"
            }
        </script>
    </query>
</etl>
