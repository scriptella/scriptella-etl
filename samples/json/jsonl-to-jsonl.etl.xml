<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE etl SYSTEM "http://scriptella.org/dtd/etl.dtd">
<etl>
    <description>Transform JSON Lines with format inferred from the input and output filenames.</description>
    <connection id="source" driver="json" url="customers.jsonl"/>
    <connection id="target" driver="json" url="output/transformed-customers.jsonl"/>

    <query connection-id="source">
        <script connection-id="target">
            {
                "customerId": ?{row.id},
                "profile": {
                    "displayName": ?{row.customer.name},
                    "active": ?{row.customer.active}
                },
                "purchases": ?{row.items},
                "externalCode": ?{row['external.code']},
                "note": ?{row.note},
                "source": "customer-import"
            }
        </script>
    </query>
</etl>
